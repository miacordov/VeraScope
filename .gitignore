# ── Datos: fuera de Git salvo backend/data/demo/ (incluidas demo/respuestas/) ──
# Los datos reales viajan en Git como un solo paquete (backend/paquete-datos/*.tar.gz, 33 MB, no se
# modifica al usar la API). Se instala en backend/data/ con `verascope-datos instalar`.
backend/data/*
!backend/data/demo/
*.tar.gz
!backend/paquete-datos/*.tar.gz
datos/
# app/datos/ es código (cliente de POWER, celdas), no datos
!backend/app/datos/

# ── Python ──
.venv/
venv/
__pycache__/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ── Frontend (Expo / React Native) ──
node_modules/
.expo/
dist/
web-build/
*.apk
*.aab
*.ipa
npm-debug.*
yarn-error.*
.env
.env.local
!.env.example

# ── Sistema y editores ──
.DS_Store
Thumbs.db
.idea/
.vscode/

# ── Herramientas locales ──
.gga

# ── Bloqueos de LibreOffice/Office ──
.~lock.*#
~$*
